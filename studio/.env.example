# ── Studio Créa IA — configuration ───────────────────────────────────────────
# Copiez ce fichier en `.env` puis renseignez vos clés. Redémarrez ensuite `npm start`.

# 1) fal.ai (RECOMMANDÉ — image, vidéo, voix, avatar, musique ; tarifs les plus bas)
#    Créer une clé : https://fal.ai/dashboard/keys
FAL_KEY=

# 2) Anthropic — directeur créatif (briefs → prompts, scripts, storyboards, UGC)
#    Créer une clé : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modèle Claude utilisé (défaut : claude-opus-5-5). Ex. claude-sonnet-5-5 pour réduire le coût.
# STUDIO_CLAUDE_MODEL=claude-opus-5-5

# 3) Replicate (optionnel — secours + Recraft V3 SVG pour logos vectoriels natifs)
#    Créer un jeton : https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── Options ──────────────────────────────────────────────────────────────────
# Port HTTP (défaut 3777)
# PORT=3777
# Taux de conversion affiché (1 USD → XPF)
# USD_TO_XPF=110
# Forcer le mode démo même avec des clés (tests sans coût)
# STUDIO_FORCE_MOCK=1
# Si le studio est exposé sur Internet, les fichiers locaux sont envoyés aux
# fournisseurs par URL plutôt qu'en base64 (plus rapide pour les vidéos) :
# PUBLIC_BASE_URL=https://studio.mondomaine.pf
# Dossier de données (rendus, marques, journal des travaux)
# STUDIO_DATA_DIR=./data
